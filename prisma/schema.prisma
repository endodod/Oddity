generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App-specific profile data only. Identity (email, name, password, sessions) lives in
// the neon_auth schema managed by Neon Auth (Managed Better Auth) — id here is always
// the same id Better Auth assigned the user, never generated by us. See
// src/lib/rolls.ts for how a User row gets created on first roll.
model User {
  id         String    @id
  totalEp    Int       @default(0)
  streak     Int       @default(0)
  lastPlayed DateTime?
  homeLat    Float?
  homeLon    Float?
  rolls      Roll[]
  createdAt  DateTime  @default(now())
}

model Mode {
  id      String  @id // "number" | "letters" | "dice" | "cards" | "coordinates" | "timecapsule"
  name    String
  enabled Boolean @default(true)
  rolls   Roll[]
  badges  Badge[]
}

model Roll {
  id        String      @id @default(cuid())
  userId    String
  modeId    String
  date      DateTime // day granularity, unique per (userId, modeId, date)
  rawValue  String // the generated number/letters/dice/etc, JSON-encoded
  baseEp    Int
  ep        Int // final EP after combo multiplier + named-combo bonuses
  rarity    String
  comboLabel String?
  badges    RollBadge[]
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
  mode Mode @relation(fields: [modeId], references: [id])

  @@unique([userId, modeId, date])
}

model Badge {
  id          String      @id // slug, e.g. "palindrome-7"
  modeId      String
  name        String
  description String
  rarityBand  String // Common/Uncommon/Rare/Epic/Legendary/Mythic
  epValue     Int // reference value; graded badges store the actual per-roll value on RollBadge
  rolls       RollBadge[]

  mode Mode @relation(fields: [modeId], references: [id])
}

model RollBadge {
  rollId  String
  badgeId String
  epValue Int // actual EP earned this roll (matters for graded badges)
  roll    Roll  @relation(fields: [rollId], references: [id])
  badge   Badge @relation(fields: [badgeId], references: [id])

  @@id([rollId, badgeId])
}
