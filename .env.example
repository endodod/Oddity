# Postgres connection string (Prisma). Get this from your Neon project's
# Connection Details panel.
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/oddity?sslmode=require"

# Neon Auth (Managed Better Auth). Enable Auth on your Neon project/branch
# (Console: Project -> Branch -> Auth -> Configuration) to get the Auth URL below.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/oddity/auth"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="generate-a-random-32+-char-string-here"

# Add OAuth provider credentials via the Neon Console's Auth configuration as needed
# (Google, GitHub, etc.) rather than raw env vars here — see docs/auth/guides/setup-oauth.
